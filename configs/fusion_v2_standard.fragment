# Fusion V2 Standard — only features already present in the OnePlus 6.6 source tree.

# Network compatibility retained from the first audited GKI.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_IP6_NF_TARGET_HL=y

# Container / Termux compatibility already implemented by the common kernel source.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Keep the standard security mechanism unless a dedicated compatibility test proves otherwise.
CONFIG_SECURITY_SAFESETID=y

# Deliberately NOT present here:
# - CONFIG_NTSYNC: enabled only after the clean upstream NTSYNC source layer is installed.
# - CONFIG_MQ_IOSCHED_ADIOS: enabled only after a reviewed Linux 6.6 backport exists.
# - CONFIG_BBG / CONFIG_DRM_LINDROID_EVDI: deferred optional layers.
