# Fusion V2 Standard — only features already present in the pinned OnePlus 6.6 Fusion common tree.

# Network compatibility retained from the first audited GKI.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_IP6_NF_TARGET_HL=y

# Container / Termux compatibility already implemented by the common kernel source.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Windows/Linux compatibility already implemented in the pinned Fusion common.
CONFIG_NTSYNC=y

# Keep ADIOS available, but do not force it as the default MQ I/O scheduler in Standard.
CONFIG_MQ_IOSCHED_ADIOS=y
# CONFIG_MQ_IOSCHED_DEFAULT_ADIOS is not set

# Keep the standard security mechanism unless a dedicated compatibility test proves otherwise.
CONFIG_SECURITY_SAFESETID=y

# Deferred optional layers are intentionally not enabled in Standard:
# - CONFIG_BBG
# - CONFIG_DRM_LINDROID_EVDI
