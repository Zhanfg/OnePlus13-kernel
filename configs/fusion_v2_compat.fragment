# Fusion V2 compatibility layer — stage only after the root baseline builds

# Network features present in OnePlus 6.6 source but absent from stock GKI config.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_IP6_NF_TARGET_HL=y

# Linux/container compatibility present in source. Keep this layer separate from root.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Retain the standard SafeSetID LSM while expanding namespace support.
CONFIG_SECURITY_SAFESETID=y
