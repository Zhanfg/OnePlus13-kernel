#!/sbin/sh
# ============================================================================
# AnyKernel3 update-binary - 一加13 (sun/SM8750) 自定义内核
#
# 这是 AnyKernel3 的标准入口, 由 recovery 调用
# 它会加载 anykernel.sh 中的配置和自定义逻辑
# ============================================================================

# AnyKernel3 版本
ANYKERNEL_VERSION="3.0"

# 设置路径
export HOME=/tmp/anykernel
export PATH=/sbin:/system/bin:/system/xbin

# 清屏
clear

# 显示开始
echo "***********************"
echo " AnyKernel3 $ANYKERNEL_VERSION"
echo " 一加13 自定义内核"
echo "***********************"
echo ""

# 解压 AK3 文件到 /tmp/anykernel
cd /tmp/anykernel

# 加载 anykernel.sh
. /tmp/anykernel/anykernel.sh

# AnyKernel3 标准流程
# 1. 设备检查
# 2. 备份 (由 anykernel.sh 处理)
# 3. 交互菜单 (由 anykernel.sh 处理)
# 4. KPM 补丁 (由 anykernel.sh 处理)
# 5. 写入策略 (由 anykernel.sh 处理)
# 6. split_boot + flash_boot (由 AnyKernel3 框架处理)

# 以下为 AnyKernel3 标准刷写流程
# (anykernel.sh 中已声明 block=init_boot; split_boot; flash_boot;)

# 设备检查
if [ "$do.device.check" = "1" ]; then
    device_check
fi

# 解包 boot 镜像
split_boot

# 刷写
flash_boot

# 清理
if [ "$do.cleanup" = "1" ]; then
    cleanup
fi

echo ""
echo "***********************"
echo " 刷写完成!"
echo "***********************"
echo ""
echo " 调度: $SCHED_CHOICE"
echo " TCP:  $TCP_CHOICE"
echo " qdisc:$QDISC_CHOICE"
echo " ZRAM: $ZRAM_CHOICE"
echo " BBG:  $BBG_CHOICE"
echo " KPM:  $KPM_CHOICE"
echo " 备份: $BACKUP_CHOICE"
echo ""
echo " 请重启设备"
echo "***********************"

# 退出码 0 = 成功
exit 0
